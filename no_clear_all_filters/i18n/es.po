#. module: no_clear_all_filters
#. odoo-javascript
#: code:addons/no_clear_all_filters/static/src/xml/clear_filters.xml:0
msgid "Clear All"
msgstr "Borrar Todo"

#. module: no_clear_all_filters
#: model:ir.module.module,shortdesc:base.module_no_clear_all_filters
msgid "Clear All Filters Button"
msgstr "Botón Borrar Todos los Filtros"

#. module: no_clear_all_filters
#: model:ir.module.module,description:base.module_no_clear_all_filters
msgid ""
"Clear All Filters Button adds a single button next to the search bar that "
"removes all active filters, group-bys, favorites, and typed queries in one "
"click. Uses Odoo's native searchModel API. Pure frontend, zero server "
"impact, no configuration."
msgstr ""
"Botón Borrar Todos los Filtros añade un único botón junto a la barra de "
"búsqueda que elimina todos los filtros, agrupaciones, favoritos y consultas "
"escritas en un clic. Usa la API nativa searchModel de Odoo. Frontend puro, "
"sin impacto en el servidor, sin configuración."

#. module: no_clear_all_filters
#. odoo-javascript
#: code:addons/no_clear_all_filters/static/src/xml/clear_filters.xml:0
msgid "Clear all active filters, group-bys, and favorites"
msgstr "Borrar todos los filtros, agrupaciones y favoritos activos"

#. module: no_clear_all_filters
#: model:ir.module.module,summary:base.module_no_clear_all_filters
msgid ""
"One-click button to clear all active filters, group-bys, favorites, and "
"typed queries from the search bar"
msgstr ""
"Botón de un clic para borrar todos los filtros, agrupaciones, favoritos y "
"consultas escritas de la barra de búsqueda"
